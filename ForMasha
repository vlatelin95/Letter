local function createFirework(position)

	local rocket = Instance.new("Part")

	rocket.Size =
		Vector3.new(0.35, 0.35, 0.35)

	rocket.Position = position

	rocket.Anchored = true
	rocket.CanCollide = false
	rocket.CanTouch = false
	rocket.CanQuery = false

	rocket.Shape = Enum.PartType.Ball
	rocket.Material = Enum.Material.Neon

	rocket.Color =
		Color3.fromRGB(255, 220, 240)

	rocket.Parent = workspace

	--------------------------------------------------------
	-- ХВОСТ
	--------------------------------------------------------

	local trail =
		Instance.new("ParticleEmitter")

	trail.Texture =
		"rbxasset://textures/particles/sparkles_main.dds"

	trail.Rate = 35

	trail.Lifetime =
		NumberRange.new(0.25, 0.5)

	trail.Speed =
		NumberRange.new(1, 3)

	trail.SpreadAngle =
		Vector2.new(15, 15)

	trail.LightEmission = 1

	trail.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(1, 0)
	})

	trail.Parent = rocket

	--------------------------------------------------------
	-- ПОЛЁТ
	--------------------------------------------------------

	local target =
		position +
		Vector3.new(
			math.random(-5, 5),
			math.random(22, 32),
			math.random(-5, 5)
		)

	local flight = TweenService:Create(
		rocket,

		TweenInfo.new(
			1.1,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),

		{
			Position = target
		}
	)

	flight:Play()

	flight.Completed:Connect(function()

		if not rocket.Parent then
			return
		end

		----------------------------------------------------
		-- ВЗРЫВ
		----------------------------------------------------

		local explosion =
			Instance.new("Part")

		explosion.Size =
			Vector3.new(1, 1, 1)

		explosion.Position =
			rocket.Position

		explosion.Anchored = true
		explosion.CanCollide = false
		explosion.CanTouch = false
		explosion.CanQuery = false

		explosion.Transparency = 1
		explosion.Parent = workspace

		----------------------------------------------------
		-- ВСПЫШКА
		----------------------------------------------------

		local light =
			Instance.new("PointLight")

		light.Brightness = 20
		light.Range = 45

		light.Color =
			Color3.fromRGB(
				math.random(180, 255),
				math.random(80, 220),
				math.random(150, 255)
			)

		light.Parent = explosion

		----------------------------------------------------
		-- ИСКРЫ
		----------------------------------------------------

		local particles =
			Instance.new("ParticleEmitter")

		particles.Texture =
			"rbxasset://textures/particles/sparkles_main.dds"

		particles.Rate = 0

		particles.Lifetime =
			NumberRange.new(1.4, 2.4)

		particles.Speed =
			NumberRange.new(18, 34)

		particles.SpreadAngle =
			Vector2.new(360, 360)

		particles.LightEmission = 1
		particles.LightInfluence = 0

		particles.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.7),
			NumberSequenceKeypoint.new(0.4, 0.4),
			NumberSequenceKeypoint.new(1, 0)
		})

		particles.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.75, 0.3),
			NumberSequenceKeypoint.new(1, 1)
		})

		local color1 =
			Color3.fromRGB(
				math.random(200, 255),
				math.random(60, 150),
				math.random(120, 255)
			)

		local color2 =
			Color3.fromRGB(
				255,
				math.random(150, 240),
				math.random(180, 255)
			)

		particles.Color =
			ColorSequence.new(color1, color2)

		particles.Parent = explosion

		particles:Emit(160)

		----------------------------------------------------
		-- ИСЧЕЗНОВЕНИЕ
		----------------------------------------------------

		TweenService:Create(
			light,

			TweenInfo.new(0.8),

			{
				Brightness = 0,
				Range = 5
			}

		):Play()

		Debris:AddItem(explosion, 3)
		Debris:AddItem(rocket, 0.1)

	end)

end

