		TweenInfo.new(
			0.7,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),

		{
			Size =
				UDim2.new(0.84, 0, 0.62, 0),

			Position =
				UDim2.new(0.08, 0, 0.19, 0)
		}

	):Play()

	if not firstOpen then

		firstOpen = true
		startEffects()

	end

end

