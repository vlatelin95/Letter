local effectsStarted = false

local function startEffects()

	if effectsStarted then
		return
	end

	effectsStarted = true

	local startTime = os.clock()

	--------------------------------------------------------
	-- ФЕЙЕРВЕРКИ
	--------------------------------------------------------

	task.spawn(function()

		while
			os.clock() - startTime
			< EFFECT_DURATION
		do

			local character =
				player.Character

			if character then

				local root =
					character:FindFirstChild(
						"HumanoidRootPart"
					)

				if root then

					local position =
						root.Position +
						Vector3.new(
							math.random(-45, 45),
							0,
							math.random(-45, 45)
						)

					createFirework(position)

				end

			end

			task.wait(FIREWORK_INTERVAL)

		end

	end)

	--------------------------------------------------------
	-- СЕРДЦА
	--------------------------------------------------------

	task.spawn(function()

		while
			os.clock() - startTime
			< EFFECT_DURATION
		do

			local character =
				player.Character

			if character then

				local root =
					character:FindFirstChild(
						"HumanoidRootPart"
					)

				if root then

					local position =
						root.Position +
						Vector3.new(
							math.random(-13, 13),
							math.random(1, 9),
							math.random(-13, 13)
						)

					createWorldHeart(position)

				end

			end

			task.wait(HEART_INTERVAL)

		end

	end)

end

