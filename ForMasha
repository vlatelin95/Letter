local function createWorldHeart(position)

	local part = Instance.new("Part")

	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Position = position

	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false

	part.Transparency = 1
	part.Parent = workspace

	local billboard = Instance.new("BillboardGui")

	billboard.Size =
		UDim2.new(0, 70, 0, 70)

	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Parent = part

	local heart =
		createGlossyHeart(billboard, 62)

	heart.AnchorPoint =
		Vector2.new(0.5, 0.5)

	heart.Position =
		UDim2.fromScale(0.5, 0.5)

	--------------------------------------------------------
	-- ПЛАМЯ
	--------------------------------------------------------

	local flame =
		Instance.new("ParticleEmitter")

	flame.Texture =
		"rbxasset://textures/particles/fire_main.dds"

	flame.Rate = 25

	flame.Lifetime =
		NumberRange.new(0.25, 0.55)

	flame.Speed =
		NumberRange.new(0.5, 2)

	flame.SpreadAngle =
		Vector2.new(360, 360)

	flame.LightEmission = 1
	flame.LightInfluence = 0

	flame.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(0.5, 0.25),
		NumberSequenceKeypoint.new(1, 0)
	})

	flame.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.7, 0.4),
		NumberSequenceKeypoint.new(1, 1)
	})

	flame.Parent = part

	--------------------------------------------------------
	-- СВЕЧЕНИЕ
	--------------------------------------------------------

	local light =
		Instance.new("PointLight")

	light.Color =
		Color3.fromRGB(255, 70, 120)

	light.Brightness = 1.5
	light.Range = 8
	light.Parent = part

	--------------------------------------------------------
	-- ПОЛЁТ
	--------------------------------------------------------

	local target =
		position +
		Vector3.new(
			math.random(-9, 9),
			math.random(5, 13),
			math.random(-9, 9)
		)

	TweenService:Create(
		part,

		TweenInfo.new(
			math.random(25, 40) / 10,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out
		),

		{
			Position = target
		}

	):Play()

	--------------------------------------------------------
	-- ИСЧЕЗНОВЕНИЕ
	--------------------------------------------------------

	task.delay(2.4, function()

		flame.Enabled = false

		for _, object in ipairs(
			heart:GetDescendants()
		) do

			if object:IsA("TextLabel") then

				TweenService:Create(
					object,
					TweenInfo.new(0.7),
					{
						TextTransparency = 1
					}
				):Play()

			end

		end

		TweenService:Create(
			light,
			TweenInfo.new(0.7),
			{
				Brightness = 0
			}
		):Play()

	end)

	Debris:AddItem(part, 3.5)

end

